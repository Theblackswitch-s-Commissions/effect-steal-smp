{
    "data_pack": {
        "load": [
            "libraries/SwitchLib-v2.0.3.zip",
            "src/datapack"
        ],
        "name": "Effect Steal SMP Datapack"
    },
    "resource_pack": {
        "load": ["src/resourcepack"],
        "name": "Effect Steal SMP Resourcepack"
    },
    "pipeline": [
        "plugins.aliases",
        "mecha"
    ],
    "id": "effect_steal",
    "name": "effect_steal",
    "description": "",
    "version": "1.0.0a",
    "require": [
        "bolt"
    ],
    "output": "build",
    "meta": {
        "aliases": [
            {
                "regex": "__version__",
                "replace": "v2.0",
                "comment": "The switch lib major version"
            },
            {
                "regex": "__patch__",
                "replace": "patch-3",
                "comment": "The switch lib major version"
            }
        ]
    }
}
