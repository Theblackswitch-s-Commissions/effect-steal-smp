"""
NONE   | LVL 1  | LVL 2
0:00  -> 0:00  -> 0:00
0:05  -> 0:11  -> 0:22        (2.2 -> 4.4)
0:07  -> 0:15  -> 0:30        (2.15 -> 4.29)
0:15  -> 0:30  -> 0:45        (2.02 -> 3)
0:20  -> 0:45  -> 1:30        (2.25 -> 4.5)
0:21  -> 0:45  -> 1:30        (2.15 -> 4.29)
0:22  -> 0:45  -> 1:30        (2.04 -> 4.09)
0:30  -> 0:45  -> 1:30        (1.51 -> 3)
0:45  -> 1:30  -> 3:00        (2 -> 4)
1:20  -> 3:00  -> 5:00        (2.26 -> 3.75)
1:30  -> 3:00  -> 5:00        (2.01 -> 3.34)
3:00  -> 5:00  -> 8:00        (1.67 -> 2.67)
8:00  -> 12:00 -> 16:00       (1.5 -> 2)
4:00  -> 7:00  -> 10:00       (1.75 -> 2.5)
"""


def even_more_duration(duration):
    if duration == 0:
        return 0
    elif duration == 14400:
        return 19200
    elif duration == 9600:
        return 14400
    elif duration == 6000:
        return 9600
    elif duration == 3600:
        return 6000
    elif duration == 1800:
        return 3600
    elif duration == 900:
        return 1800
    else:
        raise Exception(f"Couldn't process potion duration {duration}!")

def number_to_roman(nbr):
    romans = [
        (1000, "M"), (900, "CM"), (500, "D"), (400, "CD"),
        (100, "C"), (90, "XC"), (50, "L"), (40, "XL"),
        (10, "X"), (9, "IX"), (5, "V"), (4, "IV"), (1, "I")
    ]

    result = ""
    for value, letter in romans:
        result += letter * (nbr // value)
        nbr %= value

    return result

def tick_to_minutes(nbr):
    seconds = math.floor((nbr / 20) % 60)
    minutes = math.floor(nbr / 1200)

    return f"{minutes:02d}:{seconds:02d}"
