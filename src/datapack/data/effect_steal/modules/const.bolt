"""
0:00 -> 0:00 (1 -> 1)
0:20 -> 1:30 (2.25 -> 4.5)
0:21 -> 1:30 (2.14 -> 4.29)
0:22 -> 1:30 (2.045 -> 4.09)
0:45 -> 3:00 (2 -> 4)
1:30 -> 8:00 (3.34 -> 5.34)
3:00 -> 8:00 (1.67 -> 2.67)
8:00 -> 16:00 (1.5 -> 2)
4:00 -> 10:00 (1.75 -> 2.5)
"""


def even_more_duration(duration):
    if duration == 1:
        return 1
    elif duration == 2.25:
        return 4.5
    elif duration == 2.14:
        return 4.29
    elif duration == 2.045:
        return 4.09
    elif duration == 2:
        return 4
    elif duration == 3.34:
        return 5.34
    elif duration == 1.67:
        return 2.67
    elif duration == 1.5:
        return 2
    elif duration == 1.75:
        return 2.5
    else:
        raise Exception(f"Couldn't process potion duration {duration}!")
