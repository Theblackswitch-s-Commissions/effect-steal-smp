# ==========================================================================================================================================
# ------------------------------------------------------------------------------------------------------------------------------------------
#                                                        ALCHEMY TABLE UI                                                                       
# ------------------------------------------------------------------------------------------------------------------------------------------
# ==========================================================================================================================================

# -------------------------------
#  Item models                            
# -------------------------------

textures = [
    "main",
    "main_click_down",
    "main_click_middle",
    "main_click_up",
    "recipe_book",
]


for texture in textures:
    create_gui_model(texture)


for box in const.info_boxes:
    create_gui_model("info_box/" + box)

# -------------------------------
#  Item definition                            
# -------------------------------

cases = []

for box in const.info_boxes:
    cases.append({
        "when": f"info_box:{box}",
        "model": {
            "type": "minecraft:model",
            "model": f"effect_steal:item/gui/alchemy_table/info_box/{box}"
        }
    })



item_model effect_steal:gui/alchemy_table {
	"model": {
		"type": "minecraft:composite",
		"models": [
			{
				"type": "minecraft:select",
				"property": "minecraft:custom_model_data",
				"index": 0,
				"cases": [
					{
						"when": "click:up",
						"model": {
							"type": "minecraft:model",
							"model": "effect_steal:item/gui/alchemy_table/main_click_up"
						}
					},
                    {
						"when": "click:middle",
						"model": {
							"type": "minecraft:model",
							"model": "effect_steal:item/gui/alchemy_table/main_click_middle"
						}
					},
                    {
						"when": "click:down",
						"model": {
							"type": "minecraft:model",
							"model": "effect_steal:item/gui/alchemy_table/main_click_down"
						}
					}
				],
				"fallback": {
					"type": "minecraft:model",
					"model": "effect_steal:item/gui/alchemy_table/main"
				}
			},
			{
				"type": "minecraft:select",
				"property": "minecraft:custom_model_data",
				"index": 1,
				"cases": [
					{
						"when": "recipe_book:true",
						"model": {
							"type": "minecraft:model",
							"model": "effect_steal:item/gui/alchemy_table/recipe_book"
						}
					}
				],
				"fallback": {
					"type": "minecraft:empty"
				}
			},
			{
				"type": "minecraft:select",
				"property": "minecraft:custom_model_data",
				"index": 2,
				"cases": cases,
				"fallback": {
					"type": "minecraft:empty"
				}
			}
		]
	},
	"oversized_in_gui": true
}